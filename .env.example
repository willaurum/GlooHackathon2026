# Copy to .env if you want to change the defaults.
# docker compose reads .env automatically.

POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo
POSTGRES_DB=gloo

# AI provider for news summaries. Default is the team's Ollama server over the SSH
# tunnel (no key, no guardrails). From Docker Desktop the host is host.docker.internal.
# Running scripts/fetch_news.py directly on your machine uses http://localhost:11434/v1.
AI_PROVIDER=ollama
AI_FALLBACK=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1   (docker-compose already defaults to this)
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
GLOO_API_KEY=
GLOO_MODEL=gloo-anthropic-claude-haiku-4.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# newsdata.io free key, used by backend/scripts/fetch_news.py and POST /api/news/refresh
NEWSDATA_API_KEY=
