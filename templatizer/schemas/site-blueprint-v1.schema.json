    "Region": {
      "additionalProperties": false,
      "description": "A country the church prays for and serves in. Only the whole country is ever shown, never a point.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "country": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Country",
          "type": "string"
        },
        "country_code": {
          "pattern": "^[A-Z]{3}$",
          "title": "Country Code",
          "type": "string"
        },
        "codename": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Codename",
          "type": "string"
