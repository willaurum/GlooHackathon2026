# Copy to .env if you want to change the defaults.
# docker compose reads .env automatically.

POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo
POSTGRES_DB=gloo

# AI Provider Selection (ollama, gloo, openai, anthropic)
# Without a configured provider, the widget offers basic local demo replies.
AI_PROVIDER=ollama
AI_FALLBACK=

# Ollama / Local AI endpoints (OpenAI-compatible /v1 format for chat & recommendations)
# Inside Docker on Linux/Windows, host.docker.internal reaches the host service.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# AI Base URL for Calendar and direct OpenAPI/Ollama integrations
# Leave AI_BASE_URL blank to run calendar in "AI offline" mode.
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3.8:27b
AI_API_KEY=

# Gloo AI Studio > API Credentials
GLOO_API_KEY=
GLOO_MODEL=gloo-anthropic-claude-haiku-4.5

# platform.openai.com / console.anthropic.com (API keys, not chat subscriptions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
