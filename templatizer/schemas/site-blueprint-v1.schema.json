        "field_of_ministry": {
          "default": "",
          "maxLength": 300,
          "title": "Field Of Ministry",
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
