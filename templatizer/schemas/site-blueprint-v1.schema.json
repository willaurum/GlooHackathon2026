      "title": "Template",
      "type": "string"
    },
    "church_slug": {
      "maxLength": 40,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "title": "Church Slug",
      "type": "string"
    },
    "source_urls": {
      "items": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
