# Copy to .env if you want to change the defaults.
# docker compose reads .env automatically.

POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo
POSTGRES_DB=gloo

# AI provider for summaries (Gloo AI Studio > API Credentials). Optional: without a key,
# live-news summaries fall back to the headline text.
AI_PROVIDER=gloo
AI_FALLBACK=
GLOO_API_KEY=
GLOO_MODEL=gloo-anthropic-claude-haiku-4.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# newsdata.io free key, used by backend/scripts/fetch_news.py and POST /api/news/refresh
NEWSDATA_API_KEY=
