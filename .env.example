# Copy to .env if you want to change the defaults.
# docker compose reads .env automatically.

POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo
POSTGRES_DB=gloo

# AI providers for the chat widget. AI_PROVIDER is tried first; AI_FALLBACK
# takes over if the first has no key or a call fails (gloo, openai, anthropic, ollama).
# Without a configured provider, the widget offers basic local demo replies.
AI_PROVIDER=gloo
AI_FALLBACK=openai

# Gloo AI Studio > API Credentials
GLOO_API_KEY=
GLOO_MODEL=gloo-anthropic-claude-haiku-4.5

# platform.openai.com / console.anthropic.com (API keys, not chat subscriptions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# AI summaries for the Calendar area. Any OpenAI / Ollama-compatible endpoint works
# (for example a local Ollama). Leave AI_BASE_URL blank and the calendar runs in
# "AI offline" mode: events still list, filter, and save, but summaries are disabled.
# Under docker compose, blank falls AI_BASE_URL back to OLLAMA_BASE_URL and AI_MODEL
# back to OLLAMA_MODEL, so pointing everything at one Ollama only needs the two below.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Ollama. Set AI_PROVIDER=ollama to use it for the chat and Find a place too
# (no API key needed; /v1 is added for the chat if missing). Leave the URL blank:
# under docker compose it means http://host.docker.internal:11434/v1, which is the
# HPC tunnel (or any Ollama) on your own machine. Open the tunnel with
# -L 0.0.0.0:11434, not -L 127.0.0.1:11434, or the container cannot reach it; on
# Linux also allow the Docker bridges through the firewall. See the README,
# "HPC Ollama for local development".
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:20b

# docker compose keeps each church's database in local SQLite files (CHURCH_DB_URL=sqlite).
# Production uses the church-db Durable Object instead.
# CHURCH_DB_URL=sqlite

# newsdata.io key for live Prayer map news (POST /api/news/refresh and backend/scripts/fetch_news.py).
NEWSDATA_API_KEY=
