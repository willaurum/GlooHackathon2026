# Copy to .env if you want to change the defaults.
# docker compose reads .env automatically.

POSTGRES_USER=gloo
POSTGRES_PASSWORD=gloo
POSTGRES_DB=gloo

# AI Endpoint Configuration for AI Summaries
# Compatible with any OpenAPI / OpenAI endpoint or local LLM (Ollama, LM Studio, vLLM, etc.):
AI_BASE_URL=http://127.0.0.1:11434
# Optional: Bearer API key if using a hosted provider (e.g. OpenAI)
# AI_API_KEY=your_api_key_here

# Configurable summarization model (defaults to qwen3.8:27b, can be changed to any installed model)
AI_MODEL=qwen3.8:27b

# Legacy / backward-compatible aliases:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.8:27b

